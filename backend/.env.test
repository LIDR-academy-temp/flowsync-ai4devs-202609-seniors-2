# Base de pruebas: el servicio `db-test` de compose.yaml (en memoria, sin volumen).
# Adonis carga este fichero solo con NODE_ENV=test y gana sobre `.env`. Se repiten
# los cinco DB_*, no solo los que cambian: si faltara uno, caería al valor de `.env` y
# la batería acabaría escribiendo en la base de desarrollo.
SESSION_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
